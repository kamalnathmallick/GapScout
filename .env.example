# GapScout environment reference.
# Copy to .env (never commit .env). Every value below has a safe dev default in
# infra/docker-compose.yml, so `make up` works before you create this file.

# --- Core ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Signs tokens and share links. Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-change-me

# --- Database (Postgres 16 + PostGIS) ---
# Used by the API and workers inside Docker.
DATABASE_URL=postgresql+psycopg://gapscout:gapscout@db:5432/gapscout
# Used by the db container itself and by host-side tools.
POSTGRES_USER=gapscout
POSTGRES_PASSWORD=gapscout
POSTGRES_DB=gapscout
POSTGRES_PORT=5432

# --- Redis / Celery ---
REDIS_URL=redis://redis:6379/0
REDIS_PORT=6379

# --- Web ---
# Ports published on the host.
API_PORT=8000
WEB_PORT=3000
SCRAPER_PORT=8080
# Browser-facing API URL (must be reachable from the user's browser).
NEXT_PUBLIC_API_URL=http://localhost:8000
# Comma-separated allowed origins for the API.
CORS_ORIGINS=http://localhost:3000

# --- Scraper provider (gosom/google-maps-scraper) ---
SCRAPER_BASE_URL=http://scraper:8080
# Parallel scrape subtasks.
SCRAPER_CONCURRENCY=2

# --- Safety caps (per workspace) ---
MAX_CELLS_PER_JOB=200
MAX_PLACES_PER_JOB=5000

# --- LLM enrichment (Prompt 11) ---
# From https://console.anthropic.com. Leave empty to disable enrichment.
ANTHROPIC_API_KEY=
# Check https://docs.anthropic.com for current model identifiers before enabling.
LLM_MODEL_FAST=claude-haiku-4-5
LLM_MODEL_QUALITY=claude-sonnet-4-5
# Daily spend limit per workspace, in USD.
LLM_DAILY_COST_CAP_USD=2

# --- Geocoding (Nominatim) ---
# Identifies your app politely; replace the email with a real contact.
GEOCODER_USER_AGENT=gapscout/1.0 (you@example.com)

# --- Map tiles (Prompt 9) ---
# A free MapLibre style; do not hot-link the public OSM tile server.
MAP_TILE_STYLE_URL=https://tiles.openfreemap.org/styles/liberty

# --- Retention and ML gates ---
DATA_RETENTION_DAYS=90
ML_MIN_LABELS=150
ML_MIN_POSITIVES=20
ML_RETRAIN_EVERY=25

# --- Observability ---
# Optional Sentry DSN; leave empty to disable.
SENTRY_DSN=
